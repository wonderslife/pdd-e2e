# pc-007-point-import 环境变量 —— 执行前请确认
PC_URL=http://localhost:80
PC_USER=admin
PC_PASS=admin123

# 样例 Excel：按「巡检点位导入模板」填写，含 1 条合法行 + 1 条非法行
# 旧路径 D:/APPPROJECTS/... 已随项目迁移失效；新路径在 pdd-test-system 工作区内，
# chrome-devtools-mcp 的 upload_file 仅允许访问工作区根内的文件
IMPORT_XLSX_PATH=E:/ZHAI/APPPROJECT/pdd-test-system/testcases/Inspection-System-Project/testcases/frontend/data/point-import-sample.xlsx
IMPORT_XLSX_NAME=point-import-sample.xlsx

# 合法行的点位编码，用于导入后搜索校验
IMPORT_POINT_CODE=RM-AT-${RUN_TAG}-P99
