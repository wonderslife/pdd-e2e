# h5-002-abnormal-submit 环境变量 —— 执行前请确认
H5_URL=http://localhost:3002
H5_USER=admin
H5_PASS=admin123

# H5 异常用例用「点位 02」，避免与 h5-001 的周期锁定冲突
PC_URL=http://localhost:80
# PC 域登录态注入用（h5 用例上下文里 80 域无 token，PC 侧步骤前 js 调接口登录）
PC_USER=admin
PC_PASS=admin123
POINT_2_NAME=自动化测试点位-02
POINT_CODE_2=RM-AT-${RUN_TAG}-P02

# 异常项内容
ABN_DESC=机房温度 31.5℃，超过 18~27℃ 标准区间
ABN_VALUE=31.5
H5_ABN_REMARK=自动化回归-H5异常提交

# 现场照片：H5 拍照在浏览器中由 input[type=file] 承载
# run-20260930-104640 实锤：chrome-devtools-mcp 未协商 MCP roots 能力时 upload_file
# 只允许 OS 临时目录（Access denied: ... not within any of the configured workspace roots），
# 仓库内路径必被拒 → 照片须放在 %TEMP% 下（由回归 runner 负责从 data/ 同步过去）
TEST_IMAGE_PATH=C:/Users/Administrator/AppData/Local/Temp/site-photo.jpg
